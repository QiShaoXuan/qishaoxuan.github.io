# Node 24 reads .env through the dev/start scripts. Do not commit a real .env.
NODE_ENV=development
# Production: keep loopback because Nginx is the only public entry point.
# Priority: API_HOST, HOSTNAME, then 127.0.0.1.
API_HOST=127.0.0.1
# Priority: API_PORT, PORT, then 3000.
API_PORT=3000
# Defaults: Pages + both local origins in development; Pages only otherwise.
# Explicit values must be exact origins. Local origins are development-only.
# Production: API_ALLOWED_ORIGINS=https://qishaoxuan.github.io
API_ALLOWED_ORIGINS=https://qishaoxuan.github.io,http://localhost:5173,http://127.0.0.1:5173
API_CHAT_RATE_LIMIT_MAX=10
API_CHAT_RATE_LIMIT_WINDOW_MS=60000
# Chat currently returns a fixed, explicitly marked mock; no model is configured.
# Never put secrets in frontend environment variables.
