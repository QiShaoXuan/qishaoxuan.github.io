NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NODE_OPTIONS=--max-old-space-size=640
# Keep credentials on the SERVER only. Default mock never calls the model.
# This file uses systemd EnvironmentFile syntax, not shell commands.

# Exact browser origin, without trailing slash or path.
API_ALLOWED_ORIGINS=https://qishaoxuan.github.io

API_CHAT_MODE=mock
# Set mode=deepseek and fill DEEPSEEK_API_KEY on the server to enable real chat.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
API_CHAT_TIMEOUT_MS=60000
API_CHAT_MAX_TOKENS=1024
API_CHAT_MAX_CONCURRENCY=2
# In-memory request limit; reset on restart, not a persistent billing budget.
API_CHAT_DAILY_LIMIT=100
