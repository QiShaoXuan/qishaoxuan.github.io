[Unit]
Description=Resume website
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=resume
Group=resume
WorkingDirectory=/srv/resume/current
EnvironmentFile=/etc/resume/resume.env
EnvironmentFile=-/srv/resume/current/release.env
ExecStart=/opt/node/bin/node /srv/resume/current/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/resume
StateDirectory=resume
RuntimeDirectory=resume
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=resume
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
